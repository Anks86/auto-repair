{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babbal-auto-repair",
  "main": "./worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": true,
  // Public runtime configuration. The Turnstile secret stays encrypted in Cloudflare.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEV4ssCwimCIg8sc",
    "EMAIL_FROM": "website@niagaraautorepair.com",
    "EMAIL_TO": "babbalautorepair@gmail.com",
    "TURNSTILE_HOSTNAME": "niagaraautorepair.com"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "babbalautorepair@gmail.com",
      "allowed_sender_addresses": [
        "website@niagaraautorepair.com"
      ]
    }
  ]
}
