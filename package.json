{
  "name": "babbal-auto-repair-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test",
    "audit": "npm run build && node scripts/final-audit.mjs && npm test && npm run check:worker",
    "qa": "npm run build && node scripts/qa-preview.mjs",
    "dev": "npm run build && wrangler dev",
    "check:worker": "npm run build && wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.124.0"
  }
}
